@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Edit Combo"];
}

<h2>@Localizer["Edit Combo"]</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="comboId" value="@Model.ProductID" />

    <h4>@Localizer["Products"]</h4>

    @foreach (var p in ViewBag.Products)
    {
        var checkedItem = ((List<int>)ViewBag.ComboItems).Contains(p.ProductID);
        <div>
            <input type="checkbox" name="productIds" value="@p.ProductID" @(checkedItem ? "checked" : "") />
            @p.ProductName
        </div>
    }

    <br />

    <button class="btn btn-success">
        @Localizer["Save"]
    </button>
</form>
