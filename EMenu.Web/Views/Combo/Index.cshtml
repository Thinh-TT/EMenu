@model List<EMenu.Domain.Entities.Product>
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Combo Management"];
}

<h2>@Localizer["Combo Management"]</h2>

<table class="table">
    <thead>
        <tr>
            <th>@Localizer["ID"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Price"]</th>
            <th>@Localizer["Actions"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var combo in Model)
        {
            <tr>
                <td>@combo.ProductID</td>
                <td>@combo.ProductName</td>
                <td>@combo.Price.ToVnd()</td>
                <td>
                    <a href="/Combo/Edit/@combo.ProductID" class="btn btn-warning">
                        @Localizer["Edit"]
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
