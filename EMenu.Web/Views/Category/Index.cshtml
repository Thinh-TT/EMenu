@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Category Management"];
}

<h2>@Localizer["Category Management"]</h2>

<a href="/Category/Create" class="btn btn-primary">@Localizer["Add Category"]</a>

<table class="table">
    <thead>
        <tr>
            <th>@Localizer["ID"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Actions"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryID</td>
                <td>@item.CategoryName</td>
                <td class="table-actions">
                    <a class="table-action-link" href="/Category/Edit/@item.CategoryID">@Localizer["Edit"]</a>
                    <form asp-action="Delete" asp-route-id="@item.CategoryID" method="post" class="table-action-form">
                        <button type="submit" class="btn btn-link table-action-link">
                            @Localizer["Delete"]
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
