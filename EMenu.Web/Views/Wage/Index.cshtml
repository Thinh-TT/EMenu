@model EMenu.Web.ViewModels.WageIndexViewModel

<h2>Wage Management</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Create / Update Wage Profile</h5>
        <form method="post" asp-action="Upsert" class="row g-3 align-items-end">
            <input type="hidden" name="month" value="@Model.Month" />
            <input type="hidden" name="year" value="@Model.Year" />
            <div class="col-md-4">
                <label class="form-label">Staff</label>
                <select class="form-select" name="staffId" required>
                    <option value="">Select staff</option>
                    @foreach (var staff in Model.Staffs)
                    {
                        <option value="@staff.StaffID">@staff.StaffName (@staff.StaffID)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Base Salary</label>
                <input type="number" class="form-control" name="baseSalary" min="0" step="1000" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hourly Rate</label>
                <input type="number" class="form-control" name="hourlyRate" min="0" step="1000" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Save</button>
            </div>
        </form>
    </div>
</div>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-3">
    <div class="col-md-2">
        <label class="form-label">Month</label>
        <input class="form-control" type="number" min="1" max="12" name="month" value="@Model.Month" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Year</label>
        <input class="form-control" type="number" min="2000" max="9999" name="year" value="@Model.Year" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Apply Month</button>
    </div>
</form>

<h4>Current Wage Profiles</h4>
<table class="table">
    <thead>
        <tr>
            <th>Staff</th>
            <th>Base Salary</th>
            <th>Hourly Rate</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Wages.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No wage profiles.</td>
            </tr>
        }
        else
        {
            @foreach (var wage in Model.Wages)
            {
                <tr>
                    <td>@(wage.Staff?.StaffName ?? $"Staff {wage.StaffID}") (@wage.StaffID)</td>
                    <td>@wage.BaseSalary.ToString("N0")</td>
                    <td>@wage.HourlyRate.ToString("N0")</td>
                </tr>
            }
        }
    </tbody>
</table>

<h4>Monthly Hours and Wage Estimate (@Model.Month/@Model.Year)</h4>
<table class="table">
    <thead>
        <tr>
            <th>Staff</th>
            <th>Work Days</th>
            <th>Total Hours</th>
            <th>Base Salary</th>
            <th>Hourly Rate</th>
            <th>Estimated Wage</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.MonthlySummary.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No monthly data.</td>
            </tr>
        }
        else
        {
            @foreach (var report in Model.MonthlySummary)
            {
                <tr>
                    <td>@report.StaffName (@report.StaffId)</td>
                    <td>@report.WorkDays</td>
                    <td>@report.TotalHours.ToString("N2")</td>
                    <td>@report.BaseSalary.ToString("N0")</td>
                    <td>@report.HourlyRate.ToString("N0")</td>
                    <td>@report.EstimatedWage.ToString("N0")</td>
                </tr>
            }
        }
    </tbody>
</table>
