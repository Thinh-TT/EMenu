@using EMenu.Domain.Enums
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Create Product"];
}

<h2>@Localizer["Create Product"]</h2>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <label>@Localizer["Name"]</label>
    <input name="ProductName" class="form-control" />

    <label>@Localizer["Price"]</label>
    <input name="Price" class="form-control" />

    <label>@Localizer["Category"]</label>
    <select name="CategoryID" class="form-control">
        @foreach (var c in ViewBag.Categories)
        {
            <option value="@c.CategoryID">@c.CategoryName</option>
        }
    </select>

    <label>@Localizer["Image"]</label>
    <input type="file" name="ImageFile" class="form-control" />

    <label>@Localizer["Description"]</label>
    <textarea name="Description" class="form-control"></textarea>

    <label>@Localizer["Product Type"]</label>
    <select name="ProductType" class="form-control">
        <option value="1">@Localizer["Single"]</option>
        <option value="2">@Localizer["Combo"]</option>
    </select>

    <label>@Localizer["Status"]</label>
    <input type="checkbox" name="IsAvailable" value="true" />

    <br />

    <button class="btn btn-success">@Localizer["Save"]</button>
</form>
