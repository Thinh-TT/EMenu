@model EMenu.Web.ViewModels.VNPayResultViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["VNPay Payment Failed"];
}

<section class="page-intro">
    <h2>@Localizer["VNPay Payment Failed"]</h2>
    <p>@Model.Message</p>

    <table class="table">
        <tbody>
            <tr>
                <th>@Localizer["Transaction Ref"]</th>
                <td>@Model.TxnRef</td>
            </tr>
            <tr>
                <th>@Localizer["Session"]</th>
                <td>@Model.SessionId</td>
            </tr>
            <tr>
                <th>@Localizer["Order"]</th>
                <td>@Model.OrderId</td>
            </tr>
            <tr>
                <th>@Localizer["Response Code"]</th>
                <td>@Model.ResponseCode</td>
            </tr>
            <tr>
                <th>@Localizer["Transaction Status"]</th>
                <td>@Model.TransactionStatus</td>
            </tr>
            <tr>
                <th>@Localizer["VNPay Transaction No"]</th>
                <td>@Model.TransactionNo</td>
            </tr>
            <tr>
                <th>@Localizer["Pay Date"]</th>
                <td>@Model.PayDate</td>
            </tr>
        </tbody>
    </table>

    <div class="checkout-actions">
        @if (Model.SessionId.HasValue)
        {
            <a class="btn btn-warning" href="/Checkout?sessionId=@Model.SessionId.Value">@Localizer["Back To Checkout"]</a>
        }
        <a class="btn btn-link" href="/Table">@Localizer["Back To Table"]</a>
    </div>
</section>
