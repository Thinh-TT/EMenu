@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Create User"];
}

<h2>@Localizer["Create User"]</h2>

<form method="post">
    @Html.AntiForgeryToken()

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.PasswordPolicy != null)
    {
        <div class="alert alert-info">@ViewBag.PasswordPolicy</div>
    }

    <label>@Localizer["Username"]</label>
    <input name="UserName" class="form-control" value="@Model?.UserName" />

    <label>@Localizer["Password"]</label>
    <input name="Password" type="password" class="form-control" />

    <label>@Localizer["Confirm Password"]</label>
    <input name="confirmPassword" type="password" class="form-control" />

    <label>@Localizer["Role"]</label>
    <select name="roleId" class="form-control">
        @foreach (var r in ViewBag.Roles)
        {
            <option value="@r.RoleID">@r.RoleName</option>
        }
    </select>

    <br />

    <button class="btn btn-success">@Localizer["Save"]</button>
</form>
