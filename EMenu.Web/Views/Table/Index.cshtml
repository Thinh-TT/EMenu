@using System.Text.Json
@model IReadOnlyList<EMenu.Domain.Entities.RestaurantTable>
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Table Management"];
    var tableClientData = Model.Select(table => new
    {
        id = table.TableID,
        name = table.TableName,
        status = table.Status
    });

    var pageDataJson = JsonSerializer.Serialize(new
    {
        tables = tableClientData,
        actor = User.Identity?.Name ?? "Anonymous",
        i18n = new
        {
            sessionStarted = Localizer["Session started"].Value,
            unableToStartSession = Localizer["Unable to start session"].Value,
            sessionEnded = Localizer["Session ended"].Value,
            unableToEndSession = Localizer["Unable to end session"].Value,
            chooseValidTargetTable = Localizer["Please choose a valid target table."].Value,
            transferSuccessful = Localizer["Transfer successful. Moved orders: {0}"].Value,
            mergeSuccessful = Localizer["Merge successful. Moved orders: {0}"].Value,
            unableToCompleteTableAction = Localizer["Unable to complete table action"].Value,
            sourceTableNotFound = Localizer["Source table not found."].Value,
            noValidTargetTable = Localizer["No valid target table for this action."].Value,
            transfer = Localizer["Transfer"].Value,
            merge = Localizer["Merge"].Value,
            tableAction = Localizer["Table Action"].Value,
            transferDescription = Localizer["Transfer from {0}. Select a valid target table below."].Value,
            mergeDescription = Localizer["Merge from {0}. Select a valid target table below."].Value,
            busy = Localizer["Busy"].Value,
            available = Localizer["Available"].Value,
            requestFailed = Localizer["Request failed."].Value
        }
    });
}

<section class="table-stage">
    <h2>@Localizer["Table Management"]</h2>
    <p>@Localizer["Open, transfer, merge, or close sessions with a clearer overview of capacity and live table states."]</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="table-grid">
        @foreach (var table in Model)
        {
            var (statusClass, statusText) = table.Status switch
            {
                1 => ("table-box table-box--busy", Localizer["Busy"].Value),
                2 => ("table-box table-box--reserved", Localizer["Reserved"].Value),
                _ => ("table-box table-box--free", Localizer["Available"].Value)
            };

            <div class="@statusClass">
                <div>
                    <span class="status-pill">@statusText</span>
                    <h3 class="mt-3">@table.TableName</h3>
                    <p>@Localizer["Capacity: {0}", table.Capacity]</p>
                </div>

                <div class="table-box-actions">
                    @if (table.Status == 0)
                    {
                        <button onclick="openTable(@table.TableID)">@Localizer["Open"]</button>
                    }

                    @if (table.Status == 1)
                    {
                        <button class="btn btn-danger"
                                onclick="endTable(@table.TableID)">
                            @Localizer["End Session"]
                        </button>

                        <button class="btn btn-warning"
                                onclick="window.location='/Table/Bill?tableId=@table.TableID'">
                            @Localizer["Bill"]
                        </button>

                        <button onclick="openTransferModal(@table.TableID)">
                            @Localizer["Transfer"]
                        </button>

                        <button onclick="openMergeModal(@table.TableID)">
                            @Localizer["Merge"]
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</section>

<div id="tableActionModal"
     class="combo-modal table-action-modal"
    aria-hidden="true"
     role="dialog"
     aria-modal="true">
    <div class="combo-modal-card">
        <h3 id="tableActionTitle">@Localizer["Table Action"]</h3>
        <p id="tableActionDescription" class="table-action-modal__meta"></p>

        <label for="targetTableSelect">@Localizer["Target table"]</label>
        <select id="targetTableSelect" class="form-select"></select>

        <input id="tableActionType" type="hidden" />
        <input id="sourceTableId" type="hidden" />

        <div class="table-action-modal__actions">
            <button type="button" class="btn btn-secondary" onclick="closeTableActionModal()">@Localizer["Cancel"]</button>
            <button type="button" class="btn btn-primary" onclick="confirmTableAction()">@Localizer["Confirm"]</button>
        </div>
    </div>
</div>

<script>
    window.tableManagementData = @Html.Raw(pageDataJson);
</script>
<script src="/js/table.js"></script>
