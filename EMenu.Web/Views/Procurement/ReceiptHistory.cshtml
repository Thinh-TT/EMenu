@model EMenu.Web.ViewModels.ProcurementReceiptHistoryViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Receipt History"];
}

<h2>@Localizer["Receipt History"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Suppliers"]</a>
    <a asp-action="CreateReceipt" class="btn btn-primary">@Localizer["Create Receipt"]</a>
</div>

<form method="get" asp-action="ReceiptHistory" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">@Localizer["From date"]</label>
        <input type="date" class="form-control" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label">@Localizer["To date"]</label>
        <input type="date" class="form-control" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-4">
        <label class="form-label">@Localizer["Supplier"]</label>
        <select class="form-select" name="supplierId">
            @if (!Model.SupplierId.HasValue)
            {
                <option value="" selected>@Localizer["All suppliers"]</option>
            }
            else
            {
                <option value="">@Localizer["All suppliers"]</option>
            }

            @foreach (var supplier in Model.Suppliers)
            {
                if (Model.SupplierId == supplier.SupplierID)
                {
                    <option value="@supplier.SupplierID" selected>@supplier.Name</option>
                }
                else
                {
                    <option value="@supplier.SupplierID">@supplier.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">@Localizer["Filter"]</button>
    </div>
</form>

<div class="alert alert-info">
    <strong>@Localizer["Total import value:"]</strong> @Model.TotalAmount.ToString("N0")
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Localizer["Receipt"]</th>
            <th>@Localizer["Date"]</th>
            <th>@Localizer["Supplier"]</th>
            <th>@Localizer["Staff"]</th>
            <th>@Localizer["Items"]</th>
            <th>@Localizer["Total"]</th>
            <th>@Localizer["Detail"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Receipts.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">@Localizer["No receipt data found."]</td>
            </tr>
        }
        else
        {
            @foreach (var receipt in Model.Receipts)
            {
                <tr>
                    <td>#@receipt.ReceiptId</td>
                    <td>@receipt.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@receipt.SupplierName</td>
                    <td>@receipt.StaffName</td>
                    <td>@receipt.ItemCount</td>
                    <td>@receipt.TotalAmount.ToString("N0")</td>
                    <td>
                        @if (!receipt.Items.Any())
                        {
                            <span class="text-muted">@Localizer["No detail"]</span>
                        }
                        else
                        {
                            <ul class="mb-0 ps-3">
                                @foreach (var item in receipt.Items)
                                {
                                    <li>
                                        @item.IngredientName:
                                        @item.Quantity.ToString("N2")
                                        x
                                        @item.Price.ToString("N2")
                                    </li>
                                }
                            </ul>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
