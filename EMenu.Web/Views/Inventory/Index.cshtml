@model EMenu.Web.ViewModels.InventoryIndexViewModel

<h2>Inventory Ingredients</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="alert alert-info">
    <strong>Low stock items:</strong> @Model.LowStockCount
</div>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label">Keyword</label>
        <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Ingredient name" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Sort by</label>
        <select class="form-select" name="sortBy">
            @if (Model.SortBy == "name")
            {
                <option value="name" selected>Name</option>
            }
            else
            {
                <option value="name">Name</option>
            }

            @if (Model.SortBy == "stock")
            {
                <option value="stock" selected>Stock</option>
            }
            else
            {
                <option value="stock">Stock</option>
            }

            @if (Model.SortBy == "min")
            {
                <option value="min" selected>Min stock</option>
            }
            else
            {
                <option value="min">Min stock</option>
            }

            @if (Model.SortBy == "gap")
            {
                <option value="gap" selected>Stock gap</option>
            }
            else
            {
                <option value="gap">Stock gap</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <div class="form-check mt-4">
            @if (Model.LowStockOnly)
            {
                <input type="checkbox" class="form-check-input" id="lowStockOnly" name="lowStockOnly" value="true" checked />
            }
            else
            {
                <input type="checkbox" class="form-check-input" id="lowStockOnly" name="lowStockOnly" value="true" />
            }
            <label class="form-check-label" for="lowStockOnly">Low stock only</label>
        </div>
    </div>

    <div class="col-md-2">
        <div class="form-check mt-4">
            @if (Model.Descending)
            {
                <input type="checkbox" class="form-check-input" id="descending" name="descending" value="true" checked />
            }
            else
            {
                <input type="checkbox" class="form-check-input" id="descending" name="descending" value="true" />
            }
            <label class="form-check-label" for="descending">Descending</label>
        </div>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Apply</button>
    </div>
</form>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Create Ingredient</h5>
        <form method="post" asp-action="CreateIngredient" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Name</label>
                <input class="form-control" type="text" name="name" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Unit</label>
                <input class="form-control" type="text" name="unit" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Stock</label>
                <input class="form-control" type="number" name="stockQuantity" min="0" step="0.01" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Min stock</label>
                <input class="form-control" type="number" name="minStock" min="0" step="0.01" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">Create</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0">Ingredient List</h4>
    <a asp-action="Mapping" class="btn btn-outline-primary">Open Product Mapping</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Unit</th>
            <th>Stock</th>
            <th>Min</th>
            <th>Status</th>
            <th style="min-width: 420px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Ingredients.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No ingredients found.</td>
            </tr>
        }
        else
        {
            @foreach (var ingredient in Model.Ingredients)
            {
                var isLow = ingredient.StockQuantity <= ingredient.MinStock;
                <tr>
                    <td>@ingredient.IngredientID</td>
                    <td>@ingredient.Name</td>
                    <td>@ingredient.Unit</td>
                    <td>@ingredient.StockQuantity.ToString("N2")</td>
                    <td>@ingredient.MinStock.ToString("N2")</td>
                    <td>
                        @if (isLow)
                        {
                            <span class="badge bg-danger">Low</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="UpdateIngredient" class="row g-2 mb-2">
                            <input type="hidden" name="ingredientId" value="@ingredient.IngredientID" />
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" name="name" value="@ingredient.Name" required />
                            </div>
                            <div class="col-md-2">
                                <input type="text" class="form-control form-control-sm" name="unit" value="@ingredient.Unit" required />
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm" name="stockQuantity" min="0" step="0.01" value="@ingredient.StockQuantity" required />
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm" name="minStock" min="0" step="0.01" value="@ingredient.MinStock" required />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-sm btn-warning w-100">Update</button>
                            </div>
                        </form>

                        <div class="d-flex gap-2">
                            <form method="post" asp-action="AddStock" class="d-flex gap-2">
                                <input type="hidden" name="ingredientId" value="@ingredient.IngredientID" />
                                <input type="number" class="form-control form-control-sm" name="quantity" min="0.01" step="0.01" placeholder="Add stock" required />
                                <button type="submit" class="btn btn-sm btn-outline-success">Import +</button>
                            </form>

                            <form method="post" asp-action="DeleteIngredient">
                                <input type="hidden" name="ingredientId" value="@ingredient.IngredientID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
