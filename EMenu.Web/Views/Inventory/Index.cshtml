@model EMenu.Web.ViewModels.InventoryIndexViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Inventory Ingredients"];
}

<h2>@Localizer["Inventory Ingredients"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="alert alert-info">
    <strong>@Localizer["Low stock items:"]</strong> @Model.LowStockCount
</div>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label">@Localizer["Keyword"]</label>
        <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="@Localizer["Ingredient name"]" />
    </div>

    <div class="col-md-2">
        <label class="form-label">@Localizer["Sort by"]</label>
        <select class="form-select" name="sortBy">
            @if (Model.SortBy == "name")
            {
                <option value="name" selected>@Localizer["Name"]</option>
            }
            else
            {
                <option value="name">@Localizer["Name"]</option>
            }

            @if (Model.SortBy == "stock")
            {
                <option value="stock" selected>@Localizer["Stock"]</option>
            }
            else
            {
                <option value="stock">@Localizer["Stock"]</option>
            }

            @if (Model.SortBy == "min")
            {
                <option value="min" selected>@Localizer["Min stock"]</option>
            }
            else
            {
                <option value="min">@Localizer["Min stock"]</option>
            }

            @if (Model.SortBy == "gap")
            {
                <option value="gap" selected>@Localizer["Stock gap"]</option>
            }
            else
            {
                <option value="gap">@Localizer["Stock gap"]</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <div class="form-check mt-4">
            @if (Model.LowStockOnly)
            {
                <input type="checkbox" class="form-check-input" id="lowStockOnly" name="lowStockOnly" value="true" checked />
            }
            else
            {
                <input type="checkbox" class="form-check-input" id="lowStockOnly" name="lowStockOnly" value="true" />
            }
            <label class="form-check-label" for="lowStockOnly">@Localizer["Low stock only"]</label>
        </div>
    </div>

    <div class="col-md-2">
        <div class="form-check mt-4">
            @if (Model.Descending)
            {
                <input type="checkbox" class="form-check-input" id="descending" name="descending" value="true" checked />
            }
            else
            {
                <input type="checkbox" class="form-check-input" id="descending" name="descending" value="true" />
            }
            <label class="form-check-label" for="descending">@Localizer["Descending"]</label>
        </div>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">@Localizer["Apply"]</button>
    </div>
</form>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Localizer["Create Ingredient"]</h5>
        <form method="post" asp-action="CreateIngredient" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">@Localizer["Name"]</label>
                <input class="form-control" type="text" name="name" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Localizer["Unit"]</label>
                <input class="form-control" type="text" name="unit" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Localizer["Stock"]</label>
                <input class="form-control" type="number" name="stockQuantity" min="0" step="0.01" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Localizer["Min stock"]</label>
                <input class="form-control" type="number" name="minStock" min="0" step="0.01" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">@Localizer["Create"]</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0">@Localizer["Ingredient List"]</h4>
    <a asp-action="Mapping" class="btn btn-outline-primary">@Localizer["Open Product Mapping"]</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Localizer["ID"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Unit"]</th>
            <th>@Localizer["Stock"]</th>
            <th>@Localizer["Min"]</th>
            <th>@Localizer["Status"]</th>
            <th style="min-width: 420px;">@Localizer["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Ingredients.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">@Localizer["No ingredients found."]</td>
            </tr>
        }
        else
        {
            @foreach (var ingredient in Model.Ingredients)
            {
                var isLow = ingredient.StockQuantity <= ingredient.MinStock;
                <tr>
                    <td>@ingredient.IngredientID</td>
                    <td>@ingredient.Name</td>
                    <td>@ingredient.Unit</td>
                    <td>@ingredient.StockQuantity.ToString("N2")</td>
                    <td>@ingredient.MinStock.ToString("N2")</td>
                    <td>
                        @if (isLow)
                        {
                            <span class="badge bg-danger">@Localizer["Low"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Localizer["OK"]</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="UpdateIngredient" class="row g-2 mb-2">
                            <input type="hidden" name="ingredientId" value="@ingredient.IngredientID" />
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" name="name" value="@ingredient.Name" required />
                            </div>
                            <div class="col-md-2">
                                <input type="text" class="form-control form-control-sm" name="unit" value="@ingredient.Unit" required />
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm" name="stockQuantity" min="0" step="0.01" value="@ingredient.StockQuantity" required />
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm" name="minStock" min="0" step="0.01" value="@ingredient.MinStock" required />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-sm btn-warning w-100">@Localizer["Update"]</button>
                            </div>
                        </form>

                        <div class="d-flex gap-2">
                            <form method="post" asp-action="AddStock" class="d-flex gap-2">
                                <input type="hidden" name="ingredientId" value="@ingredient.IngredientID" />
                                <input type="number" class="form-control form-control-sm" name="quantity" min="0.01" step="0.01" placeholder="@Localizer["Add stock"]" required />
                                <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Import +"]</button>
                            </form>

                            <form method="post" asp-action="DeleteIngredient">
                                <input type="hidden" name="ingredientId" value="@ingredient.IngredientID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
