@using System.Text.Json
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Your Order Status"];
    var pageDataJson = JsonSerializer.Serialize(new
    {
        sessionId = (int)ViewBag.SessionId,
        tableId = (int?)ViewBag.TableId,
        checkoutRequested = (bool?)ViewBag.CheckoutRequested == true,
        i18n = new
        {
            pending = Localizer["Pending"].Value,
            preparing = Localizer["Preparing"].Value,
            ready = Localizer["Ready"].Value,
            served = Localizer["Served"].Value,
            cancelled = Localizer["Cancelled"].Value,
            callCheckout = Localizer["Call checkout"].Value,
            checkoutRequestedButton = Localizer["Checkout requested"].Value,
            checkoutHint = Localizer["Tap here when you are ready for the staff to bring your bill."].Value,
            checkoutRequestedMessage = Localizer["The staff has been notified and will come to your table shortly."].Value,
            unableToCallCheckout = Localizer["Unable to call checkout"].Value,
            waitingForItems = Localizer["Your items will appear here after the kitchen receives them."].Value,
            payOnline = Localizer["Pay Online (VNPay)"].Value,
            payOnlineHint = Localizer["Pay directly via VNPay online payment gateway."].Value
        }
    });
}

<section class="tracking-stage">
    <div class="tracking-stage__header">
        <div>
            <h2>@Localizer["Your Order Status"]</h2>
            <p>@Localizer["Track each item in real time and let the staff know when you are ready to checkout."]</p>
        </div>

        <div class="tracking-checkout-card">
            <button id="callCheckoutButton" type="button" class="btn btn-warning">
                @Localizer["Call checkout"]
            </button>
            <p id="checkoutCallState" class="tracking-checkout-card__state">
                @Localizer["Tap here when you are ready for the staff to bring your bill."]
            </p>

            <hr class="tracking-checkout-card__divider">

            <button id="vnpayButton" type="button" class="btn btn-primary">
                @Localizer["Pay Online (VNPay)"]
            </button>
            <p id="vnpayHint" class="tracking-checkout-card__state">
                @Localizer["Pay directly via VNPay online payment gateway."]
            </p>
        </div>
    </div>

    <div id="orderStatus" class="tracking-list"></div>
</section>

<script>
    window.trackingPageData = @Html.Raw(pageDataJson);
</script>
<script src="/js/signalr.min.js"></script>
<script src="/js/tracking.js" asp-append-version="true"></script>
