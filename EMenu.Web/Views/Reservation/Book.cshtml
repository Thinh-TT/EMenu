@model EMenu.Web.ViewModels.ReservationBookViewModel

<h2>Book A Table</h2>
<p class="text-muted">Submit your reservation online. Our staff will confirm as soon as possible.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Book" class="js-reservation-form row g-3">
            <div class="col-md-6">
                <label class="form-label">Full name</label>
                <input type="text"
                       class="form-control"
                       name="CustomerName"
                       value="@Model.CustomerName"
                       required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Phone</label>
                <input type="text"
                       class="form-control"
                       name="CustomerPhone"
                       value="@Model.CustomerPhone" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Email</label>
                <input type="email"
                       class="form-control"
                       name="CustomerEmail"
                       value="@Model.CustomerEmail" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Table</label>
                <select class="form-select" name="TableId" required>
                    @foreach (var table in Model.Tables)
                    {
                        if (Model.TableId == table.TableID)
                        {
                            <option value="@table.TableID" selected>
                                @table.TableName (Capacity @table.Capacity)
                            </option>
                        }
                        else
                        {
                            <option value="@table.TableID">
                                @table.TableName (Capacity @table.Capacity)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Reservation time</label>
                <input type="datetime-local"
                       class="form-control"
                       name="ReservationTime"
                       value="@Model.ReservationTime.ToString("yyyy-MM-ddTHH:mm")"
                       required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Guests</label>
                <input type="number"
                       class="form-control"
                       name="NumberOfGuests"
                       min="1"
                       value="@Model.NumberOfGuests"
                       required />
            </div>
            <div class="col-12">
                <div class="small text-danger js-conflict-feedback"></div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Submit Reservation</button>
            </div>
            <div class="col-md-8 d-flex align-items-center">
                <span class="text-muted">
                    Status flow: Pending -> Confirmed -> Cancelled
                </span>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
