@model EMenu.Web.ViewModels.ReservationBookViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Book A Table"];
}

<h2>@Localizer["Book A Table"]</h2>
<p class="text-muted">@Localizer["Submit your reservation online. Our staff will confirm as soon as possible."]</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Book" class="js-reservation-form row g-3">
            <div class="col-md-6">
                <label class="form-label">@Localizer["Full name"]</label>
                <input type="text"
                       class="form-control"
                       name="CustomerName"
                       value="@Model.CustomerName"
                       required />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Localizer["Phone"]</label>
                <input type="text"
                       class="form-control"
                       name="CustomerPhone"
                       value="@Model.CustomerPhone" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Localizer["Email"]</label>
                <input type="email"
                       class="form-control"
                       name="CustomerEmail"
                       value="@Model.CustomerEmail" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Table"]</label>
                <select class="form-select" name="TableId" required>
                    @foreach (var table in Model.Tables)
                    {
                        if (Model.TableId == table.TableID)
                        {
                            <option value="@table.TableID" selected>
                                @Localizer["{0} (Capacity {1})", table.TableName, table.Capacity]
                            </option>
                        }
                        else
                        {
                            <option value="@table.TableID">
                                @Localizer["{0} (Capacity {1})", table.TableName, table.Capacity]
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Reservation time"]</label>
                <input type="datetime-local"
                       class="form-control"
                       name="ReservationTime"
                       value="@Model.ReservationTime.ToString("yyyy-MM-ddTHH:mm")"
                       required />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Guests"]</label>
                <input type="number"
                       class="form-control"
                       name="NumberOfGuests"
                       min="1"
                       value="@Model.NumberOfGuests"
                       required />
            </div>
            <div class="col-12">
                <div class="small text-danger js-conflict-feedback"></div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">@Localizer["Submit Reservation"]</button>
            </div>
            <div class="col-md-8 d-flex align-items-center">
                <span class="text-muted">
                    @Localizer["Status flow: Pending -> Confirmed -> Cancelled"]
                </span>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        window.reservationI18n = {
            unableToValidateReservationTime: "@Localizer["Unable to validate reservation time."]",
            selectedTableHasReservation: "@Localizer["Selected table already has a reservation at this time."]",
            unableToValidateNow: "@Localizer["Unable to validate reservation time right now."]"
        };
    </script>
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
