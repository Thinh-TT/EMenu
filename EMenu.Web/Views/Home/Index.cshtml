@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Home Page"];
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}

<section class="home-hero">
    <div class="home-hero-copy">
        <span class="eyebrow">@Localizer["Blue and white experience"]</span>
        <h1 class="display-4">@Localizer["Welcome"]</h1>
        <p>
            @Localizer["Learn about"]
            <a href="https://learn.microsoft.com/aspnet/core">@Localizer["building Web apps with ASP.NET Core"]</a>.
        </p>
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <div class="hero-actions">
                <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">@Localizer["Open Dashboard"]</a>
                <a class="btn btn-warning" asp-controller="Table" asp-action="Index">@Localizer["Manage Tables"]</a>
            </div>
        }
        else
        {
            <div class="hero-actions">
                <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">@Localizer["Review Menu"]</a>
                <a class="btn btn-outline-primary" asp-controller="Reservation" asp-action="Book">@Localizer["Book Table"]</a>
                <a class="btn btn-warning" asp-controller="Auth" asp-action="Login">@Localizer["Login"]</a>
            </div>
        }
        <div class="hero-feature-grid">
            <div class="feature-card">
                <strong>@Localizer["Fast service flow"]</strong>
                <span>@Localizer["QR, ordering, kitchen tracking, bill and payment are grouped into one clear experience."]</span>
            </div>
            <div class="feature-card">
                <strong>@Localizer["Simple operations"]</strong>
                <span>@Localizer["Staff, tables, products and combos stay easy to find from one navigation system."]</span>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
        <div class="flow-card">
            <h3>@Localizer["Business Flow"]</h3>
            <ul class="flow-list">
                <li>QR</li>
                <li>@Localizer["Menu"]</li>
                <li>@Localizer["Cart"]</li>
                <li>@Localizer["Order"]</li>
                <li>@Localizer["Kitchen"]</li>
                <li>@Localizer["Tracking"]</li>
                <li>@Localizer["Bill"]</li>
                <li>@Localizer["Checkout"]</li>
                <li>@Localizer["Payment"]</li>
                <li>@Localizer["End session"]</li>
            </ul>
        </div>
    }
    @if (!User.IsInRole("Admin") && !User.IsInRole("Staff"))
    {
        <div class="flow-card">
            <h3>@Localizer["Customer Guide"]</h3>
            <ul class="flow-list">
                <li>@Localizer["Sit at your table"]</li>
                <li>@Localizer["Scan the QR code at the table"]</li>
                <li>@Localizer["Enter your name and start order"]</li>
                <li>@Localizer["Choose food and add to cart"]</li>
                <li>@Localizer["Submit order and track status"]</li>
                <li>@Localizer["Request bill and complete payment"]</li>
            </ul>
        </div>
    }
</section>
