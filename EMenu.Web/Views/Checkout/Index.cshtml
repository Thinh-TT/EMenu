@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Checkout"];
}

<h2>@Localizer["Select Payment Method"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="checkout-actions">
    <form asp-controller="Payment"
          asp-action="Cash"
          asp-route-sessionId="@ViewBag.SessionId"
          method="post">
        <button type="submit"
                class="btn btn-primary">
            @Localizer["Cash Payment"]
        </button>
    </form>

    <form asp-controller="Payment"
          asp-action="VNPay"
          asp-route-sessionId="@ViewBag.SessionId"
          method="post">
        <button type="submit"
                class="btn btn-warning">
            @Localizer["VNPay Sandbox Payment"]
        </button>
    </form>
</div>
