@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Welcome"];
}

<h2>@Localizer["Welcome"]</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="tableId" value="@ViewBag.TableId" />

    <div class="mb-3">
        <label>@Localizer["Your Name *"]</label>
        <input name="name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>@Localizer["Phone (optional)"]</label>
        <input name="phone" class="form-control" maxlength="10" pattern="\d{10}" inputmode="numeric" title="@Localizer["Phone number must be exactly 10 digits."]" />
    </div>

    <div class="mb-3">
        <label>@Localizer["Email (optional)"]</label>
        <input name="email" class="form-control" />
    </div>

    <button class="btn btn-primary">
        @Localizer["Start Order"]
    </button>
</form>
