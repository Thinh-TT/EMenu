@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Staff Management"];
}

<h2>@Localizer["Staff Management"]</h2>

<a href="/Staff/Create" class="btn btn-primary">@Localizer["Add Staff"]</a>

<table class="table">
    <thead>
        <tr>
            <th>@Localizer["ID"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Phone"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Account"]</th>
            <th>@Localizer["Actions"]</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StaffID</td>
                <td>@item.StaffName</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.User?.UserName</td>
                <td class="table-actions">
                    <a class="table-action-link" href="/Staff/Edit/@item.StaffID">@Localizer["Edit"]</a>
                    <form asp-action="Delete" asp-route-id="@item.StaffID" method="post" class="table-action-form">
                        <button type="submit" class="btn btn-link table-action-link">
                            @Localizer["Delete"]
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
