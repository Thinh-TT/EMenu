@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Edit Staff"];
}

<h2>@Localizer["Edit Staff"]</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="StaffID" value="@Model.StaffID" />

    <label>@Localizer["Name"]</label>
    <input name="StaffName" value="@Model.StaffName" class="form-control" />

    <label>@Localizer["Phone"]</label>
    <input name="Phone" value="@Model.Phone" class="form-control" />

    <label>@Localizer["Email"]</label>
    <input name="Email" value="@Model.Email" class="form-control" />

    <br />

    <button class="btn btn-success">@Localizer["Update"]</button>
</form>
